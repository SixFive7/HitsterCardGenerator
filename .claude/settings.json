{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "**/!(.claude)/CLAUDE.md",
    "**/CLAUDE.local.md",
    "**/.work/**"
  ],
  "permissions": {
    "deny": [
      "Edit(/**/CLAUDE.md)",
      "Edit(/**/CLAUDE.local.md)"
    ]
  },
  "enableAllProjectMcpServers": true
}
