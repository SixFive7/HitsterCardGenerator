# Normalize all text files to LF line endings
* text=auto eol=lf

# Ensure these are always treated as text
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.ts text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Keep Windows batch files with CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Pin LF for the shared Playwright setup so these files stay byte-identical across repos,
# independent of each repo's core.autocrlf setting.
#
# Wholly-Playwright files (owned entirely by the setup):
playwright/**                   text eol=lf
.claude/hooks/playwright-*.ps1  text eol=lf
.mcp.json                       text eol=lf
.claude/settings.json           text eol=lf
#
# Partially-shared files (contain a Playwright section/block plus repo-specific content).
# Pinned LF so the shared block stays byte-identical; this normalizes the whole file's EOL.
CLAUDE.md                       text eol=lf
.gitignore                      text eol=lf
.gitattributes                  text eol=lf
